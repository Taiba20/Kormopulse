# Application
PORT=8000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Database
MONGODB_URL=mongodb://127.0.0.1:27017/kormopulse

# Authentication
ACCESS_TOKEN_SECRET=replace_with_a_long_random_access_secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=replace_with_a_long_random_refresh_secret
REFRESH_TOKEN_EXPIRY=10d

# File uploads (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional AI job-description generation
GROQ_API_KEY=your_groq_api_key
