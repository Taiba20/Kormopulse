# Application
PORT=8000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# Optional: share auth cookies across subdomains in production (e.g. .example.com).
# Leave empty unless the frontend and API run on different subdomains of one domain.
COOKIE_DOMAIN=

# Database
MONGODB_URL=mongodb://127.0.0.1:27017/kormopulse

# Authentication
ACCESS_TOKEN_SECRET=replace_with_a_long_random_access_secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=replace_with_a_long_random_refresh_secret
REFRESH_TOKEN_EXPIRY=10d

# File uploads (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional AI job-description generation, resume parsing, cover letters, interview prep
GROQ_API_KEY=your_groq_api_key

# Optional: "Sign in with Google". Must match the frontend's VITE_GOOGLE_CLIENT_ID.
# Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=

# Optional: run background jobs (hourly job-alert digests) even outside production
# DISABLE_SCHEDULER=true

# Optional: cap for requests per 15 minutes on login/signup/reset endpoints (see rateLimit.middleware.js)
# RATE_LIMIT_DISABLED=false

# Email (SMTP) - used for password reset codes and application notifications.
# If left empty, emails are skipped (reset codes print to the server console in development).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
MAIL_FROM=Kormopulse <your_email@gmail.com>
