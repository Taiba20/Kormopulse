# Use a deployed API URL here when needed.
VITE_API_URL=http://localhost:8000/api
VITE_APP_NAME=Kormopulse

# Optional: Lightcast (skills / company / university search suggestions)
VITE_LIGHTCAST_API_CLIENT_ID=your_lightcast_client_id
VITE_LIGHTCAST_API_SECRET=your_lightcast_client_secret
VITE_LIGHTCAST_API_SCOPE=emsi_open

# Optional: "Sign in with Google". Must match the backend's GOOGLE_CLIENT_ID.
# Leave empty to hide the Google sign-in button.
VITE_GOOGLE_CLIENT_ID=
